<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Company Registration & Service Request Form</title>
</head>
<body>

    <h1>Company Registration &amp; Service Request Form</h1>

    <form method="post" action="#">

        <fieldset>
            <legend>Personal Information</legend>
            
            <p>
                <label for="full-name">Full Name:</label>
                <input type="text" id="full-name" name="full_name" required minlength="3" maxlength="50">
            </p>
            <p>
                <label for="email-address">Email Address:</label>
                <input type="email" id="email-address" name="email_address" required>
            </p>
            <p>
                <label for="phone-number">Phone Number:</label>
                <input type="tel" id="phone-number" name="phone_number" required pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" placeholder="123-456-7890">
                <small>Format: 123-456-7890</small>
            </p>
        </fieldset>
        
        <fieldset>
            <legend>Company Information</legend>

            <p>
                <label for="company-name">Company Name:</label>
                <input type="text" id="company-name" name="company_name" required minlength="2">
            </p>

            <p>
                <label for="company-website">Company Website:</label>
                <input type="url" id="company-website" name="company_website" required placeholder="https://example.com">
            </p>

            <p>
                <label for="company-size">Company Size:</label>
                <select id="company-size" name="company_size" required>
                    <option value="" disabled selected>-- Select Size --</option>
                    <option value="small">1 - 10 employees</option>
                    <option value="medium">11 - 50 employees</option>
                    <option value="large">51 - 200 employees</option>
                    <option value="enterprise">201+ employees</option>
                </select>
            </p>

            <p>
                <label for="industry">Industry:</label>
                <input type="text" id="industry" name="industry" required>
            </p>
        </fieldset>

        <fieldset>
            <legend>Service Request</legend>

            <p>
                <label>Service Type:</label><br>
                <input type="radio" id="service-consulting" name="service_type" value="consulting" required>
                <label for="service-consulting">Consulting</label><br>
                
                <input type="radio" id="service-development" name="service_type" value="development">
                <label for="service-development">Development</label><br>
                
                <input type="radio" id="service-support" name="service_type" value="support">
                <label for="service-support">Support</label>
            </p>

            <p>
                <label>Preferred Contact Method:</label><br>
                <input type="checkbox" id="contact-email" name="contact_method" value="email">
                <label for="contact-email">Email</label><br>
                
                <input type="checkbox" id="contact-phone" name="contact_method" value="phone">
                <label for="contact-phone">Phone Call</label><br>
                
                <input type="checkbox" id="contact-sms" name="contact_method" value="sms">
                <label for="contact-sms">SMS Text</label>
            </p>

            <p>
                <label for="appointment-date">Preferred Appointment Date:</label>
                <input type="date" id="appointment-date" name="appointment_date" required min="2026-01-01">
            </p>

            <p>
                <label for="appointment-time">Preferred Appointment Time:</label>
                <input type="time" id="appointment-time" name="appointment_time" required>
            </p>

            <p>
                <label for="budget-range">Estimated Budget Range ($):</label>
                <input type="range" id="budget-range" name="budget_range" min="1000" max="50000" step="1000" value="10000">
            </p>
        </fieldset>

        <!-- SECTION 4: MESSAGE AND AGREEMENT -->
        <fieldset>
            <legend>Message and Agreement</legend>

            <p>
                <label for="additional-info">Additional Information / Message:</label><br>
                <textarea id="additional-info" name="additional_info" rows="5" cols="40" placeholder="Describe your request details here..."></textarea>
            </p>

            <p>
                <input type="checkbox" id="terms-conditions" name="terms_conditions" required>
                <label for="terms-conditions">I agree to the Terms and Conditions.</label>
            </p>
        </fieldset>

        <!-- FORM ACTION BUTTONS -->
        <p>
            <button type="submit">Submit Request</button>
            <button type="reset">Reset Form</button>
        </p>

    </form>

</body>
</html>
